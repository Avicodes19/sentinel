PORT=3000
# Optional — when omitted, Sentinel runs in demo mode with local seed data.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional government-data integration controls
IMD_ENABLED=true
NDMA_ENABLED=true
CENSUS_ENABLED=true

# Optional Bhuvan WMS layer. Keep blank until the exact authorized layer is selected.
BHUVAN_WMS_URL=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms
BHUVAN_WMS_LAYER=

# Optional external logistics partner webhook. POSTs resource.requested events.
SUPPLIER_WEBHOOK_URL=
